# --- LLM (sem configuração = LLM extrativo local, 100% offline) ---
# OpenAI:
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
# Ou um servidor local compatível com a API da OpenAI servindo o modelo fine-tunado
# (Ollama, vLLM, llama.cpp) — os documentos internos não saem da empresa:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=lumora-assistente
# OFFLINE=true

# --- Base de conhecimento e busca ---
KB_DIR=knowledge-base
# Cobertura mínima (0..1) para um trecho entrar no contexto
COVERAGE_THRESHOLD=0.10
TOP_K=3

DEBUG=false
